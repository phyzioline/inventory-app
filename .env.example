APP_NAME="Phyzioline Inventory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

TRUSTED_PROXIES=*

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------
# Database — PostgreSQL only. No SQLite/MySQL, standalone database,
# never shared with the phyzioline monolith.
# ------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=phyzioline_inventory
DB_USERNAME=postgres
DB_PASSWORD=password

# Test database (Pest / PHPUnit — see .env.testing.example)
# DB_DATABASE=phyzioline_inventory_test
# DB_USERNAME=phyziouser
# DB_PASSWORD=testpassword

# ------------------------------------------------------------------
# Session / Cache / Queue — this app's own Redis instance, independent
# from the monolith's.
# ------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

FILESYSTEM_DISK=local

# ------------------------------------------------------------------
# Mail (used by the forgot-password flow — App\Infrastructure\
# Notifications\InventoryResetPassword)
# ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@phyzioline.com"
MAIL_FROM_NAME="Phyzioline Inventory"

# ------------------------------------------------------------------
# Reverb (realtime stock updates) — this app's own Reverb server,
# fully independent from the monolith's. Do NOT reuse the monolith's
# REVERB_APP_ID/KEY/SECRET.
# See App\Domain\Events\StockUpdated, App\Infrastructure\Support\
# StockUpdateBroadcaster, routes/channels.php.
#
# REVERB_SERVER_PORT is where `artisan reverb:start` actually binds
# (internal only — not exposed publicly). REVERB_HOST/PORT/SCHEME/PATH
# are the PUBLIC, browser-facing connection details: nginx terminates
# TLS on 443 and proxies a sub-path (e.g. /reverb) to the internal
# server port, so these are almost never the same port as
# REVERB_SERVER_PORT. See docs/server runbook for the nginx snippet.
# ------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=inventory.phyzioline.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_PATH=/reverb
REVERB_SERVER_PORT=8091

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_REVERB_PATH="${REVERB_PATH}"

# ------------------------------------------------------------------
# Monolith CRM webhook (outbound only) — App\Infrastructure\External\
# MonolithCrmWebhookClient posts Customer/Vendor create/update events
# here as a best-effort, non-blocking HTTP call. Failures are logged
# and swallowed — a CRM outage must never block a save in this app.
# The receiver endpoint itself lives in the monolith repo (out of
# scope here).
# ------------------------------------------------------------------
MONOLITH_CRM_WEBHOOK_URL=
MONOLITH_WEBHOOK_SECRET=

# ------------------------------------------------------------------
# Gemini (Google Generative AI) — App\Infrastructure\External\
# GeminiService. Used for purchase-document smart import (OCR/parsing)
# and barcode-return label OCR. No dependency on the monolith's AI
# module. Leave GEMINI_API_KEY empty to disable AI parsing gracefully
# (falls back to the local rule-based parser / manual review).
# ------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=20
GEMINI_SMART_IMPORT_LOCAL=true

# ------------------------------------------------------------------
# Desktop auto-updater (Tauri warehouse app) — App\Application\
# Services\TauriDesktopUpdateService via App\Presentation\Http\
# Controllers\Api\InventoryDesktopUpdateController.
# Routes: GET /api/v1/inventory/desktop/version
#         GET /api/v1/inventory/desktop/update/{target}/{arch}/{current}
# ------------------------------------------------------------------
INVENTORY_APP_VERSION=1.0.0
INVENTORY_DOWNLOAD_WINDOWS=#coming-soon
INVENTORY_DOWNLOAD_MACOS=#coming-soon
INVENTORY_SIG_WINDOWS=
INVENTORY_SIG_MACOS=

# ------------------------------------------------------------------
# Super-admin (single account, cross-tenant oversight) — see
# App\Providers\AppServiceProvider::boot()'s Gate::before() and
# App\Http\Middleware\EnsureSuperAdmin. No env var needed to enable it;
# after deploying, run once:
#   php artisan admin:grant-super you@example.com
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Paymob (subscription checkout) — App\Infrastructure\External\
# PaymobCheckoutClient / App\Presentation\Http\Controllers\Api\
# PaymobWebhookController. Own merchant account for THIS app — do not
# reuse the monolith's Paymob credentials.
# PAYMOB_NOTIFICATION_URL should be https://inventory.phyzioline.com/webhooks/paymob
# Test against Paymob's sandbox before switching to live keys — see the
# HMAC field-order caveat in PaymobWebhookController's docblock.
# ------------------------------------------------------------------
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_NOTIFICATION_URL=
PAYMOB_RETURN_URL=
