{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phyzioline Inventory",
  "version": "1.0.0",
  "identifier": "com.phyzioline.inventory",
  "build": {
    "frontendDist": "../src",
    "devUrl": "https://inventory.phyzioline.com/app/index.html#/login",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Phyzioline Inventory",
        "url": "https://inventory.phyzioline.com/app/index.html#/login",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": { "target/release/WebView2Loader.dll": "WebView2Loader.dll" },
    "externalBin": [],
    "copyright": "© Phyzioline",
    "category": "Business",
    "shortDescription": "Warehouse inventory management for multi-channel sellers",
    "longDescription": "Phyzioline Inventory — stock, channels, transfers, and purchasing for warehouse teams.",
    "windows": {
      "wix": {},
      "nsis": {}
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": null,
      "signingIdentity": null,
      "dmg": {
        "background": null,
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://inventory.phyzioline.com/api/v1/inventory/desktop/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dialog": true,
      "windows": {
        "installMode": "passive"
      }
    },
    "shell": {
      "open": true
    },
    "notification": null
  }
}
