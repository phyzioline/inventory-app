# Copy to .env.testing for local Pest/PHPUnit runs (gitignored).
#
#   cp .env.testing.example .env.testing
#   php artisan key:generate --env=testing
#   createdb phyzioline_inventory_test   # or: docker compose up -d postgres

APP_ENV=testing
APP_KEY=

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=phyzioline_inventory_test
DB_USERNAME=postgres
DB_PASSWORD=password

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
BROADCAST_CONNECTION=null
BCRYPT_ROUNDS=4
