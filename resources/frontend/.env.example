# ============================
# Frontend build-time config (Vite)
# ============================
# This SPA is served by the Laravel app itself (session-cookie auth via
# /api/inventory/*, relative baseURL — see src/lib/api.ts). There is no
# separate Node/JWT backend and no VITE_API_URL to configure.
#
# Values below are read from the Laravel app's own .env at build time
# (see vite.config.ts envDir) — set REVERB_* there, not here, unless you
# need to override just the frontend build.

# Realtime stock updates (Laravel Reverb) — leave VITE_REVERB_APP_KEY empty
# to disable realtime and fall back silently (see src/lib/echo.ts).
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
